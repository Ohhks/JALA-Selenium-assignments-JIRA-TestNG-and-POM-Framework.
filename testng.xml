<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Magnus Master POM Suite" verbose="1">
    <listeners>
        <listener class-name="com.jala.magnus.listeners.ExtentTestListener"/>
    </listeners>

    <parameter name="browser" value="edge"/>
    <parameter name="testUser" value="training@jalaacademy.com"/>
    <parameter name="testPass" value="jobprogram"/>

    <test name="Login Module Tests">
        <classes>
            <class name="com.jala.magnus.tests.LoginModuleTest"/>
        </classes>
    </test>

    <test name="Employee Module Tests">
        <classes>
            <class name="com.jala.magnus.tests.EmployeeModuleTest"/>
        </classes>
    </test>

    <test name="More Features Module Tests">
        <classes>
            <class name="com.jala.magnus.tests.MoreFeaturesModuleTest"/>
        </classes>
    </test>

    <test name="Assignments 1-6 Verification">
        <classes>
            <class name="com.jala.magnus.assignments.Assignment1_LocatorsTestNG"/>
            <class name="com.jala.magnus.assignments.Assignment2_WebElementsTest"/>
            <class name="com.jala.magnus.assignments.Assignment3_WebDriverMethodsTest"/>
            <class name="com.jala.magnus.assignments.Assignment4_PopupsAlertsWindowsTest"/>
            <class name="com.jala.magnus.assignments.Assignment5_MiscellaneousTest"/>
            <class name="com.jala.magnus.assignments.Assignment6_TestNGFeaturesTest"/>
        </classes>
    </test>
</suite>
